# SecureFlow Control Center — environment variables
# Copy to .env and adjust. No secrets belong in this file or in source control.

# --- Web (Vite) ---
# Reserved for the future HTTP-provider switch (docs/integrations.md);
# not read by any code yet — the SPA always uses in-browser mock providers.
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=http://localhost:4000

# --- API ---
API_PORT=4000
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
# Reserved for the rate-limiting extension point; not read by any code yet.
RATE_LIMIT_MAX=200

# --- Future integrations (placeholders; supply via Key Vault / managed identity in Azure) ---
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# DATABASE_URL=
# REDIS_URL=
