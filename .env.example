# SecureFlow Control Center — environment variables
# Copy to .env and adjust. No secrets belong in this file or in source control.

# --- Web (Vite) ---
# NOTE: Vite's env root is apps/web/ (no envDir override), so it does NOT
# read a .env file at the repo root. Copy these VITE_* lines into
# apps/web/.env (or pass them inline) for Vite to pick them up.
# Selects the data provider mode: "http" (default) calls the FastAPI backend
# at /api/* (via the Vite dev proxy); "memory" runs fully in-browser against
# the mock dataset. See docs/local-development.md#data-modes.
VITE_DATA_SOURCE=http
# Reserved: HTTP providers currently go through the Vite dev proxy (relative
# /api/* paths); not read by any code yet.
VITE_API_BASE_URL=http://localhost:4000

# --- API ---
API_PORT=4000
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
# Reserved for the rate-limiting extension point; not read by any code yet.
RATE_LIMIT_MAX=200
# PostgreSQL connection (required — the API has no in-memory fallback).
# docker-compose.yml provides this server; the default matches it.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secureflow
# Used by pytest; a separate database on the same server.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secureflow_test
# POST /api/demo/reset returns 404 (endpoint absent) unless this is set to 1.
# Fail-closed default: disabled everywhere, including production, unless
# explicitly opted into here for local/demo use.
DEMO_RESET_ENABLED=1
# Simulator: SIM_ENABLED=0 disables it entirely; idle pause between demo runs.
SIM_IDLE_SECONDS=35

# --- Future integrations (placeholders; supply via Key Vault / managed identity in Azure) ---
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
