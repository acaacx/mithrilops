# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
RUN corepack enable pnpm

FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/
COPY packages/types/package.json packages/types/
COPY packages/mock-data/package.json packages/mock-data/
RUN pnpm install --frozen-lockfile --filter @secureflow/api...

FROM base AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY apps/api ./apps/api
COPY packages ./packages
COPY pnpm-workspace.yaml package.json ./

# Never run as root; drop privileges to a dedicated user.
RUN addgroup -g 10001 app && adduser -D -u 10001 -G app app
USER app

EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:4000/health || exit 1
CMD ["./node_modules/.bin/tsx", "apps/api/src/server.ts"]
