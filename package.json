{
  "name": "secureflow-control-center",
  "private": true,
  "version": "0.1.0",
  "description": "AI-native DevSecOps pipeline governance and orchestration platform",
  "scripts": {
    "dev": "pnpm --filter @secureflow/web dev",
    "dev:api": "pnpm --filter @secureflow/api dev",
